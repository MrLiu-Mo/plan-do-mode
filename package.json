{
  "name": "dsh-plan-do",
  "version": "0.1.0",
  "type": "module",
  "description": "把一个小想法一步步学会并做出来的 DSH 模式：AI 只教、只验收，不代写。",
  "license": "MIT",
  "author": "MrLiu-Mo <2837243604@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLiu-Mo/plan-do-mode.git"
  },
  "homepage": "https://github.com/MrLiu-Mo/plan-do-mode#readme",
  "bugs": {
    "url": "https://github.com/MrLiu-Mo/plan-do-mode/issues"
  },
  "icon": "./icon.svg",
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "agent-preset"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "docs",
    "!docs/REVIEW-*.md"
  ],
  "scripts": {
    "test": "node --test",
    "verify-pack": "node scripts/verify-pack.mjs",
    "smoke-pack": "node scripts/smoke-pack.mjs",
    "release-check": "node scripts/release-check.mjs"
  }
}
